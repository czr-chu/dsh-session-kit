{
  "name": "dsh-session-kit",
  "version": "0.10.4",
  "description": "DeepSeek Harness session manager: browse/search, size detail, archive, trash/permanent delete with selectable files, official format migration, DeepSeek share-link import into a chosen workspace, compact/full export with workspace files, and import as new sessions.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "index.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "icon.svg",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "export",
    "compact",
    "backup",
    "migration",
    "workspace",
    "archive",
    "trash",
    "management",
    "format",
    "files",
    "delete",
    "detail",
    "permanent-delete",
    "deepseek-share",
    "share-import"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:client": "tsdown --config tsdown.config.mjs",
    "build": "npm run build:client",
    "format": "prettier --write \"index.js\" \"lib/**/*.js\" \"src/**/*.js\" \"test/**/*.mjs\" \"tsdown.config.mjs\"",
    "format:check": "prettier --check \"index.js\" \"lib/**/*.js\" \"src/**/*.js\" \"test/**/*.mjs\" \"tsdown.config.mjs\""
  },
  "author": {
    "name": "CharlesChu",
    "url": "https://github.com/czr-chu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czr-chu/dsh-session-kit.git"
  },
  "homepage": "https://github.com/czr-chu/dsh-session-kit#readme",
  "bugs": {
    "url": "https://github.com/czr-chu/dsh-session-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.22.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
